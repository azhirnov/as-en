echo "update 'slang'..."
rmdir /Q /S "build"
rmdir /Q /S "..\..\..\..\..\AE-Bin\external\win-x64\slang"
rmdir /Q /S "temp"
mkdir "build"
git clone --recurse-submodules --branch "v2025.17" "..\..\..\..\..\3party\slang" "temp"
copy /Y "temp\CMakeLists.txt" "temp\origin_CMakeLists.txt"
copy /Y "slang_CMakeLists.txt" "temp\CMakeLists.txt"
cmake -S temp -B build -G "Visual Studio 17 2022" -A x64 -DAE_ENABLE_COMPILER_WARNINGS=OFF -DCMAKE_BUILD_TYPE=Debug -DAE_SIMD_SSE=20 -DAE_SIMD_AES=0 -DCMAKE_INSTALL_PREFIX="../../../../../AE-Bin/external/win-x64/slang" 
cmake --build build --config Debug --target "slang" -j 12
cmake -S temp -B build -G "Visual Studio 17 2022" -A x64 -DAE_ENABLE_COMPILER_WARNINGS=OFF -DCMAKE_BUILD_TYPE=Release -DAE_SIMD_SSE=20 -DAE_SIMD_AES=0 -DCMAKE_INSTALL_PREFIX="../../../../../AE-Bin/external/win-x64/slang" 
cmake --build build --config Release --target "slang" -j 12
mkdir "..\..\..\..\..\AE-Bin\external\win-x64\slang"
mkdir "..\..\..\..\..\AE-Bin\external\win-x64\slang\include"
mkdir "..\..\..\..\..\AE-Bin\external\win-x64\slang\lib"
copy /Y "temp\LICENSE" "..\..\..\..\..\AE-Bin\external\win-x64\slang\slang-LICENSE.txt"
copy /Y "temp\include\slang.h" "..\..\..\..\..\AE-Bin\external\win-x64\slang\include\slang.h"
copy /Y "temp\include\slang-deprecated.h" "..\..\..\..\..\AE-Bin\external\win-x64\slang\include\slang-deprecated.h"
copy /Y "temp\include\slang-image-format-defs.h" "..\..\..\..\..\AE-Bin\external\win-x64\slang\include\slang-image-format-defs.h"
copy /Y "build\Debug\bin\slang.dll" "..\..\..\..\..\AE-Bin\external\win-x64\slang\lib\slangd.dll"
copy /Y "build\Debug\bin\slang.pdb" "..\..\..\..\..\AE-Bin\external\win-x64\slang\lib\slangd.pdb"
copy /Y "build\Release\bin\slang.dll" "..\..\..\..\..\AE-Bin\external\win-x64\slang\lib\slang.dll"
rmdir /Q /S "temp"
rmdir /Q /S "build"
pause
