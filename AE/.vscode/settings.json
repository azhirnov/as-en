{
	"cmake.configureSettings": {
		"AE_SIMD_AVX": 1,
		"AE_SIMD_SSE": 0,
		"AE_SIMD_AES": 0,
		"AE_SIMD_FMA": 0,
		"AE_SIMD_F16C": 0,
		"AE_SIMD_SHA": 0,  // 0, 20(SHA2-256), 21(SHA2-512), 30(SHA3)
		"AE_ENABLE_VULKAN": "ON",
		"AE_ENABLE_REMOTE_GRAPHICS": "OFF",
		"AE_GRAPHICS_STRONG_VALIDATION": "OFF",
        "AE_ENGINE_BASE_PCH": "ON",   // enable it for Engine development, disable for Base module development
		"AE_WHOLE_ENGINE_PCH": "OFF", // enable it for App/Game development
		"AE_EXCLUDE_PACK_RES": "ON",
        "CMAKE_VS_PLATFORM_TOOLSET": "v143" // only for MSVC
	},
	"files.associations": {
		"*.as": "cpp",
		"*.ppln": "cpp",
		"*.glsl": "cpp",
		"*.glsl_dbg": "cpp"
	},
	"editor.inlayHints.enabled": "off",
	"editor.fontSize": 12,
    
//    "clangd.arguments": [ "--header-insertion" ],

	// https://github.com/microsoft/vscode-cmake-tools/blob/main/docs/variants.md
	// https://github.com/microsoft/vscode-cmake-tools/issues/3351 - build types are merged instead of replacing, so override default types
    "cmake.defaultVariants": {
        "buildType": {
            "default": "debug",
            "description": "The build type.",
            "choices": {
                "debug": {
                    "short": "Debug",
                    "long": "Disable optimizations - include debug information.",
                    "buildType": "Debug"
                },
                "release": {
                    "short": "Release",
                    "long": "Optimize for speed - exclude debug information.",
                    "buildType": "Release"
                },
                "minsizerel": {
                    "short": "Develop",
                    "long": "Debug build with some optimizations.",
                    "buildType": "Develop"
                },
                "relwithdebinfo": {
                    "short": "Profile",
                    "long": "Release build with some debug info (function names, etc).",
                    "buildType": "Profile"
                }
            }
        }
    }
}
