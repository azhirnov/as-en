#ifdef __INTELLISENSE__
#	include <pipeline_compiler.as>
#	include <glsl.h>
#endif
//-----------------------------------------------------------------------------
#ifdef SCRIPT

	void ASmain ()
	{
		{
			RC<ShaderStructType>	st = ShaderStructType( "io" );
			st.Set( EStructLayout::InternalIO,
					"float3		worldPos;"
					"uint		uniqueId;" );
		}{
			RC<DescriptorSetLayout>	ds = DescriptorSetLayout( "mtr.ds" );
			ds.UniformBuffer( EShaderStages::Vertex, "un_PerObject", "UnifiedGeometryMaterialUB" );
		}{
			RC<PipelineLayout>		pl = PipelineLayout( "pl" );
			pl.DSLayout( "pass",	 0, "pass.ds" );
			pl.DSLayout( "material", 1, "mtr.ds" );
		}

		RC<GraphicsPipeline>	ppln = GraphicsPipeline( "tmpl" );
		ppln.SetLayout( "pl" );
		ppln.SetFragmentOutputFromRenderTech( "rtech", "main" );
		ppln.SetShaderIO( EShader::Vertex, EShader::Fragment, "io" );

		{
			RC<Shader>	vs = Shader();
			vs.LoadSelf();
			ppln.SetVertexShader( vs );
		}{
			RC<Shader>	fs = Shader();
			fs.LoadSelf();
			ppln.SetFragmentShader( fs );
		}

		// specialization
		{
			RC<GraphicsPipelineSpec>	spec = ppln.AddSpecialization( "spec" );
			spec.AddToRenderTech( "rtech", "main" );  // in ScriptSceneGraphicsPass

			RenderState	rs;

			rs.depth.test					= true;
			rs.depth.write					= true;

			rs.inputAssembly.topology		= EPrimitive::TriangleList;

			rs.rasterization.frontFaceCCW	= true;
			rs.rasterization.cullMode		= ECullMode::None;

			spec.SetRenderState( rs );
		}
	}

#endif
//-----------------------------------------------------------------------------
#ifdef __INTELLISENSE__
struct Voxel
{
	uint	packedPos;
	uint	tableOffset;
	float3	vpos [12];
};
#endif
//-----------------------------------------------------------------------------
#ifdef SH_VERT
	#include "Transform.glsl"
	#include "CodeTemplates.glsl"

	void Main ()
	{
		Voxel	voxel	= un_Voxels.elements[ gl.InstanceIndex ];
		int		idx		= un_CBuf.triangleTable[ voxel.tableOffset + gl.VertexIndex ];

		if ( idx < 0 )
		{
			gl.Position = float4(float_nan);
			return;
		}

		float3	lpos	= voxel.vpos[idx] + 0.5;	// [0.5..1.5]
		float3	pos		= float3( voxel.packedPos & 0xFF, (voxel.packedPos >> 8) & 0xFF, (voxel.packedPos >> 16) & 0xFF ) + lpos;
				pos		= ToSNorm( pos / float3(iGridSize) );
				pos		= LocalPosToWorldSpace( pos ).xyz;

		gl.Position		= WorldPosToClipSpace( pos );
		Out.worldPos	= pos;
		Out.uniqueId	= (gl.InstanceIndex << 8) | (gl.VertexIndex / 3);
	}

#endif
//-----------------------------------------------------------------------------
#ifdef SH_FRAG
	#include "Normal.glsl"
	#include "Hash.glsl"
	#include "Sphere.glsl"

	void  Main ()
	{
		const float3	light_dir	= SphericalToCartesian( iLightDir );
		float3			norm		= ComputeNormalInWS_dxdy( In.worldPos );
		float			n_dot_l		= Max( Dot( light_dir, norm ), 0.1f );

		switch ( iColorMode )
		{
			case 0 :	out_Color.rgb = float3(n_dot_l);  break;
			case 1 :	out_Color.rgb = DHash31( float( In.uniqueId >> 8 ));  break;
			case 2 :	out_Color.rgb = DHash31( float( In.uniqueId ));  break;
		}
		out_Color.a = 1.0;

		if ( un_PerPass.mouse.z > 0.0 )
		{
			float	d = Distance( un_PerPass.mouse.xy * un_PerPass.resolution.xy, gl.FragCoord.xy );
			if ( d < 1.0 )
			{
				uint	packed	= uint((1.0 - gl.FragCoord.z) * 0xFFFF);
						packed	= (packed & 0xFFFF) << 16;
						packed	|= (In.uniqueId >> 8) & 0xFFFF;

				gl.AtomicMax( INOUT un_Select.packed, packed );
			}

			out_Color.rgb *= 0.5;

			if ( un_Select.instanceId == (In.uniqueId >> 8) )
				out_Color.rgb = float3(1.0);
		}
	}

#endif
//-----------------------------------------------------------------------------
