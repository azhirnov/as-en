#ifdef __INTELLISENSE__
#	include <pipeline_compiler.as>
#	include <glsl.h>
#endif
//-----------------------------------------------------------------------------
#ifdef SCRIPT

	void ASmain ()
	{
		{
			RC<ShaderStructType>	st = ShaderStructType( "io" );
			st.Set( EStructLayout::InternalIO,
					"flat float2		uvMin;"
					"flat float2		uvMax;"
					"mediump float2		uv;"
					"uint				uniqueId;" );
		}{
			RC<DescriptorSetLayout>	ds = DescriptorSetLayout( "mtr.ds" );
			ds.UniformBuffer( EShaderStages::Vertex, "un_PerObject", "UnifiedGeometryMaterialUB" );
		}{
			RC<PipelineLayout>		pl = PipelineLayout( "pl" );
			pl.DSLayout( "pass",	 0, "pass.ds" );
			pl.DSLayout( "material", 1, "mtr.ds" );
		}

		RC<GraphicsPipeline>	ppln = GraphicsPipeline( "tmpl" );
		ppln.SetLayout( "pl" );
		ppln.SetFragmentOutputFromRenderTech( "rtech", "main" );
		ppln.SetShaderIO( EShader::Vertex, EShader::Fragment, "io" );

		{
			RC<Shader>	vs = Shader();
			vs.LoadSelf();
			ppln.SetVertexShader( vs );
		}{
			RC<Shader>	fs = Shader();
			fs.LoadSelf();
			ppln.SetFragmentShader( fs );
		}

		// specialization
		{
			RC<GraphicsPipelineSpec>	spec = ppln.AddSpecialization( "spec" );
			spec.AddToRenderTech( "rtech", "main" );  // in ScriptSceneGraphicsPass

			RenderState	rs;

			rs.inputAssembly.topology		= EPrimitive::TriangleStrip;

			rs.rasterization.frontFaceCCW	= true;
			rs.rasterization.cullMode		= ECullMode::None;

			spec.SetRenderState( rs );
		}
	}

#endif
//-----------------------------------------------------------------------------
#ifdef __INTELLISENSE__
struct SdfQuad
{
	uint	packedUV;
};
#endif
//-----------------------------------------------------------------------------
#ifdef SH_VERT
	#include "Transform.glsl"
	#include "CodeTemplates.glsl"

	void Main ()
	{
		SdfQuad	quad = un_Quads.elements[ gl.InstanceIndex ];

		if ( quad.packedUV < ~0u )
		{
			Out.uvMin		= float2( quad.packedUV & 0xFFFF, quad.packedUV >> 16 ) + 0.5;
			Out.uvMax		= Out.uvMin + float2(iPixStep) - 1.0;

			if ( quad.packedUV == ~0u-1 )
				Out.uvMin = float2(-1.0);

			float2	uv		= ProceduralQuadUV();	// used 'gl.VertexIndex'
			float2	pos		= uv + float2( gl.InstanceIndex % iGridSize.x, gl.InstanceIndex / iGridSize.x );
					pos		= ToSNorm( pos / float2(iGridSize) );

			Out.uv			= uv;
			gl.Position		= float4( pos, 0.0, 1.0 );
			Out.uniqueId	= gl.InstanceIndex;
		}
		else  // empty
		{
			gl.Position		= float4(float_nan);
		}
	}

#endif
//-----------------------------------------------------------------------------
#ifdef SH_FRAG
	#include "Hash.glsl"
	#include "SDF.glsl"

	void  Main ()
	{
		float2	uv	= Lerp( In.uvMin, In.uvMax, In.uv ) * iInvDim;
		float	sdf = gl.texture.Sample( un_SDFCache, uv ).r;
				sdf	= In.uvMin.x < 0.0 ? -1.0 : sdf;

		switch ( iColorMode )
		{
			case 0 :	out_Color.rgb = float3(0.0, LessF( sdf, 0.0 ), 0.3 );  break;
			case 1 :	out_Color.rgb = SDF_Isolines( sdf * 10.0 );  break;
			case 2 :	out_Color.rgb = In.uvMin.x < 0.0 ? float3(0.0, 0.0, 0.7) :
											(sdf < 0.0 ? float3(-sdf * 10.0, 0.0, 0.2) : float3(0.0, sdf * 10.0, 0.2));  break;
			case 3 :	out_Color.rgb = DHash31( float( In.uniqueId ));  break;
			case 4 :	out_Color.rgb = In.uvMin.x < 0.0 ? float3(0.0, 0.0, 1.0) : float3( uv, 0.0 );  break;
		}

		out_Color.a = 1.0;
	}

#endif
//-----------------------------------------------------------------------------
