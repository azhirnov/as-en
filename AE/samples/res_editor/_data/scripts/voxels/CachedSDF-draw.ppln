#ifdef __INTELLISENSE__
#	include <pipeline_compiler.as>
#	include <glsl.h>
#endif
//-----------------------------------------------------------------------------
#ifdef SCRIPT

	void CreatePipeline (bool dbgFS)
	{
		string	suffix = "";
		if ( dbgFS ) suffix += ".dbgFS";

		{
			RC<PipelineLayout>		pl = PipelineLayout( "pl"+suffix );
			pl.DSLayout( "pass",	 0, "pass.ds" );
			pl.DSLayout( "material", 1, "mtr.ds" );
			if ( dbgFS )	pl.AddDebugDSLayout( EShaderOpt::Trace, EShaderStages::Fragment );
		}

		RC<GraphicsPipeline>	ppln = GraphicsPipeline( "tmpl"+suffix );
		ppln.SetLayout( "pl"+suffix );
		ppln.SetFragmentOutputFromRenderTech( "rtech", "main" );
		ppln.SetShaderIO( EShader::Vertex, EShader::Fragment, "io" );

		{
			RC<Shader>	vs = Shader();
			vs.LoadSelf();
			ppln.SetVertexShader( vs );
		}{
			RC<Shader>	fs = Shader();
			fs.LoadSelf();
			if ( dbgFS ) fs.options = EShaderOpt::Trace;
			ppln.SetFragmentShader( fs );
		}

		// specialization
		{
			RC<GraphicsPipelineSpec>	spec = ppln.AddSpecialization( "spec"+suffix );
			spec.AddToRenderTech( "rtech", "main" );  // in ScriptSceneGraphicsPass

			RenderState	rs;

			rs.depth.test					= true;
			rs.depth.write					= true;

			rs.inputAssembly.topology		= EPrimitive::TriangleList;

			rs.rasterization.frontFaceCCW	= true;
			rs.rasterization.cullMode		= ECullMode::Back;

			spec.SetRenderState( rs );
		}
	}

	void ASmain ()
	{
		{
			RC<ShaderStructType>	st = ShaderStructType( "io" );
			st.Set( EStructLayout::InternalIO,
					"flat float3		uvwMin;"
					"flat float3		uvwMax;"
					"flat uint			packedPos;"
					"mediump float3		uvw;"
					"float3				localPos;"
					"float3				worldPos;"
					"uint				uniqueId;" );
		}{
			RC<DescriptorSetLayout>	ds = DescriptorSetLayout( "mtr.ds" );
			ds.UniformBuffer( EShaderStages::Vertex, "un_PerObject", "UnifiedGeometryMaterialUB" );
		}

		CreatePipeline( false );	// default
		CreatePipeline( true  );
	}

#endif
//-----------------------------------------------------------------------------
#ifdef __INTELLISENSE__
struct Voxel
{
	uint	packedUVW;
};
#endif
//-----------------------------------------------------------------------------
#if defined(SH_VERT) or defined(SH_FRAG)

	const float3	c_LocalPosToWorld	= float3(0.0, 0.0, 4.0);	// un_PerObject.transform[3].xyz

#endif
//-----------------------------------------------------------------------------
#ifdef SH_VERT
	#include "Transform.glsl"
	#include "CodeTemplates.glsl"

	void Main ()
	{
		const uint	face	= gl.VertexIndex / 6;
		const uint	idx		= gl.VertexIndex - face * 6;
		Voxel		voxel	= un_Voxels.elements[ gl.InstanceIndex ];

		if ( voxel.packedUVW < ~0u )
		{
			Out.uvwMin		= float3( voxel.packedUVW & 0xFF, (voxel.packedUVW >> 8) & 0xFF, (voxel.packedUVW >> 16) & 0xFF ) + 0.5;
			Out.uvwMax		= Out.uvwMin + float3(iPixStep) - 1.0;

			Out.uvwMin		*= iInvDim;
			Out.uvwMax		*= iInvDim;

			if ( voxel.packedUVW == ~0u-1 )
				Out.uvwMin = float3(-1.0);	// opaque

			float3	pos		= ToUNorm( GenCube( idx, face ));
					pos		+= float3( voxel.packedPos & 0xFF, (voxel.packedPos >> 8) & 0xFF, (voxel.packedPos >> 16) & 0xFF );
					pos		= ToSNorm( pos / float3(iGridSize) );

			Out.localPos	= pos;
			Out.worldPos	= (c_LocalPosToWorld + Out.localPos - un_PerPass.camera.pos).xyz;	// same as LocalPosToWorldSpace(), but without rotation
			gl.Position		= WorldPosToClipSpace( Out.worldPos );
			Out.uniqueId	= (gl.InstanceIndex << 8) | (gl.VertexIndex / 3);
			Out.packedPos	= voxel.packedPos;
		}
		else  // empty
		{
			gl.Position		= float4(float_nan);
		}
	}

#endif
//-----------------------------------------------------------------------------
#ifdef SH_FRAG
	#include "SDF.glsl"
	#include "Hash.glsl"
	#include "TexSampling.glsl"
	#include "Intersectors.glsl"

	//layout(depth_greater) out float gl_FragDepth;

		float  SDF (float3 uvw) {
			return gl.texture.SampleLod( un_SDFCache, uvw, 0.0 ).r;
		//	return LinearFilterHQ( un_SDFCache, uvw );
		}

		GEN_SDF_NORMAL_6sp_FN( SdfNormal, SDF )

		ND_ float  SDFScene (float3 pos)
		{
			pos.x += 0.25;
			pos.y -= 0.05;

			float	d0 = SDF_Sphere( pos, 0.5 );
			float	d1 = SDF_Sphere( SDF_Move( pos, float3(0.1, -0.5, -0.3) ), 0.5 );
			float	d2 = SDF_Box(	 SDF_Move( pos, float3(0.7,  0.4, -0.2) ), float3(0.5) );
			float	d02 = SDF_OpUnite( d0, d2, 0.5 );
			return	Min( d02, d1 ) + iMinDensity;
		}

		GEN_SDF_NORMAL_6sp_FN( SDFSceneNormal, SDFScene )

	// 'ray' is in object space [-1,1], same space as in voxels/Base.as SphereTrace()
	void  SphereTrace (Ray ray, const float3 uvwMin, const float3 uvwMax, const float3 voxMin, const float3 voxMax, const float tMax, out float3 outNormal)
	{
		int		steps	= 0;
		bool	hit		= false;

		const float	min_dist = 0.00625;

		if ( iTraceMode == 0 )
		{
			const float3	inv_vox	= 1.0 / (voxMax - voxMin);

			for (; steps < iMaxSteps; ++steps)
			{
				float3	local_uvw = (ray.pos - voxMin) * inv_vox;

				if ( ray.t > tMax )
					break;

				local_uvw = Saturate( local_uvw );

				float3	uvw		= Lerp( uvwMin, uvwMax, local_uvw );
				float	dist	= gl.texture.SampleLod( un_SDFCache, uvw, 0.0 ).r * 0.9;

				if ( dist < min_dist )
				{
					local_uvw	= Clamp( local_uvw, 0.05, 0.95 );
					uvw			= Lerp( uvwMin, uvwMax, local_uvw );
					outNormal 	= SdfNormal( uvw, iInvDim.x * 0.25 );
					hit 		= true;
					break;
				}

				Ray_Move( INOUT ray, dist );
			}
		}
		else
		{
			for (; steps < iMaxSteps; ++steps)
			{
				float	dist = SDFScene( ray.pos ) * 0.9;

				Ray_Move( INOUT ray, dist );

				if ( Abs(dist) < min_dist )
				{
					hit = true;
					break;
				}
				if ( ray.t > tMax )
					break;
			}
			outNormal = SDFSceneNormal( ray.pos );
		}

		gl.image.AtomicAdd( un_StepsCount, int2(gl.FragCoord.xy), uint(steps) );

		if ( iColorMode < 2 )
		{
			if ( hit )
				gl.FragDepth = Max( gl.FragCoord.z, FastProjectZ( un_PerPass.camera.proj, ray.t ));
			else
				gl.Discard;
		}
	}


	void  Main ()
	{
		float3	norm = float3(0.0, 0.0, 0.0);

		gl.FragDepth = gl.FragCoord.z;

		// if not opaque
		if ( In.uvwMin.x >= 0.0 )
		{
			// ray in object local space [-1,1], same as in voxels/Base.as
			float3	cam_obj		= un_PerPass.camera.pos - c_LocalPosToWorld;
			Ray		ray			= Ray_Create( cam_obj, Normalize( In.localPos - cam_obj ), 0.0 );

			// voxel AABB in object space [-1,1]
			float3	coord		= float3( In.packedPos & 0xFF, (In.packedPos >> 8) & 0xFF, (In.packedPos >> 16) & 0xFF );
			float3	inv_grid	= 1.0 / float3(iGridSize);
			float3	vox_min		= ToSNorm( coord * inv_grid );
			float3	vox_max		= ToSNorm( (coord + 1.0) * inv_grid );
			AABB	aabb		= { vox_min, vox_max };

			float2	t_min_max;
			if ( ! AABB_Ray_Intersect( aabb, ray, OUT t_min_max ))
				gl.Discard;

			t_min_max.x = Max( t_min_max.x, 0.0 ) + 1.0e-3;
			Ray_SetLength( INOUT ray, t_min_max.x );

			// marching
			SphereTrace( ray, In.uvwMin, In.uvwMax, vox_min, vox_max, t_min_max.y, OUT norm );
		}

		float3	light_dir	= SphericalToCartesian( iLightDir );
		float	n_dot_l		= Max( Dot( light_dir, norm ), 0.1f );

		switch ( iColorMode )
		{
			case 0 :	out_Color.rgb = DHash31( float( In.uniqueId >> 8 ));  break;
			case 1 :	out_Color.rgb = float3(n_dot_l);  break;
			case 2 :	out_Color.rgb = DHash31( float( In.uniqueId >> 8 ));  break;
			case 3 :	out_Color.rgb = DHash32( float2( In.uniqueId >> 8, In.uniqueId & 0xFF ));  break;
		}

		if ( un_PerPass.mouse.z > 0.0 )
		{
			float	d = Distance( un_PerPass.mouse.xy * un_PerPass.resolution.xy, gl.FragCoord.xy );
			if ( d < 1.0 )
			{
				uint	packed	= uint((1.0 - gl.FragCoord.z) * 0xFFFF);
						packed	= (packed & 0xFFFF) << 16;
						packed	|= (In.uniqueId >> 8) & 0xFFFF;

				gl.AtomicMax( INOUT un_Select.packed, packed );
			}

			out_Color.rgb *= 0.5;

			if ( un_Select.instanceId == (In.uniqueId >> 8) )
				out_Color.rgb = float3(1.0);
		}
		out_Color.a = 1.0;
	}

#endif
