#ifdef __INTELLISENSE__
#	include <pipeline_compiler.as>
#	include <glsl.h>
#endif
//-----------------------------------------------------------------------------
#ifdef SCRIPT

	void ASmain ()
	{
		{
			RC<ShaderStructType>	st = ShaderStructType( "io" );
			st.Set( EStructLayout::InternalIO,
					"float3			color;" );
		}{
			RC<DescriptorSetLayout>	ds = DescriptorSetLayout( "mtr.ds" );
			ds.UniformBuffer( EShaderStages::Vertex,							"un_PerObject",	"UnifiedGeometryMaterialUB" );
			ds.StorageBuffer( EShaderStages::Vertex | EShaderStages::Fragment,	"un_Triangles", "TriangleBuffer",	EResourceState::ShaderStorage_Read );	// external
			ds.StorageBuffer( EShaderStages::Fragment,							"un_Select",	"SelectBuffer",		EResourceState::ShaderStorage_RW );		// external
		}{
			RC<PipelineLayout>		pl = PipelineLayout( "pl" );
			pl.DSLayout( "pass",	 0, "pass.ds" );
			pl.DSLayout( "material", 1, "mtr.ds" );
		}

		RC<GraphicsPipeline>	ppln = GraphicsPipeline( "tmpl" );
		ppln.SetLayout( "pl" );
		ppln.SetShaderIO( EShader::Vertex, EShader::Fragment, "io" );
		ppln.SetFragmentOutputFromRenderTech( "rtech", "main" );

		{
			RC<Shader>	vs = Shader();
			vs.LoadSelf();
			ppln.SetVertexShader( vs );
		}{
			RC<Shader>	fs = Shader();
			fs.LoadSelf();
			ppln.SetFragmentShader( fs );
		}

		// specialization
		{
			RC<GraphicsPipelineSpec>	spec = ppln.AddSpecialization( "spec" );
			spec.AddToRenderTech( "rtech", "main" );  // in ScriptSceneGraphicsPass

			RenderState		rs;
			rs.rasterization.frontFaceCCW	= false;
			rs.rasterization.cullMode		= ECullMode::None;
			rs.inputAssembly.topology		= EPrimitive::TriangleList;

			spec.SetRenderState( rs );
		}
	}

#endif
//-----------------------------------------------------------------------------
#ifdef SH_VERT

	void Main ()
	{
		gl.Position = float4( un_Triangles.position[ gl.VertexIndex ], 0.0, 1.0 );
	}

#endif
//-----------------------------------------------------------------------------
#ifdef SH_FRAG
	#include "Hash.glsl"
	#include "Color.glsl"

	void Main ()
	{
		switch ( iColorMode )
		{
			case 0 :	out_Color.rgb = DHash31( float(gl.PrimitiveID+1) * 111.11 );  break;
			case 1 :	out_Color.rgb = Rainbow2( float(gl.PrimitiveID) / float(un_Triangles.cmd.indexCount/3) ).rgb; break;
		}
		out_Color.a = 1.0;

		if ( un_Select.lastSelected != ~0u )
		{
			out_Color.rgb *= 0.5;

			if ( un_Select.lastSelected == gl.PrimitiveID )
				out_Color.rgb = float3(1.0);
		}

		if ( un_PerPass.mouse.z > 0.0 )
		{
			float	d = Distance( un_PerPass.mouse.xy * un_PerPass.resolution.xy, gl.FragCoord.xy );
			if ( d < 1.0 )
			{
				un_Select.selectedPrim = gl.PrimitiveID;
			}
		}
	}

#endif
//-----------------------------------------------------------------------------
