#ifdef __INTELLISENSE__
#	include <pipeline_compiler.as>
#	include <glsl.h>
#endif
//-----------------------------------------------------------------------------
#ifdef SCRIPT

	void ASmain ()
	{
		const string prefix = "pp.";

		RC<GraphicsPipeline>	ppln = GraphicsPipeline( prefix+"t" );
		ppln.SetLayout( "model.pl" );	// [InitPipelineLayout()](https://github.com/azhirnov/as-en/blob/dev/AE/samples/res_editor/_data/pipeline_inc/ModelTypes.as)
		ppln.SetFragmentOutputFromRenderTech( "rtech", "main" );

		{
			RC<Shader>	vs = Shader();
			vs.LoadSelf();
			ppln.SetVertexShader( vs );
		}{
			RC<Shader>	fs = Shader();
			fs.LoadSelf();
			ppln.SetFragmentShader( fs );
		}

		// specialization
		{
			RC<GraphicsPipelineSpec>	spec = ppln.AddSpecialization( prefix+"spec" );
			spec.AddToRenderTech( "rtech", "main" );  // in ScriptSceneGraphicsPass

			RenderState	rs;
			rs.inputAssembly.topology		= EPrimitive::TriangleList;
			rs.rasterization.frontFaceCCW	= true;
			rs.rasterization.cullMode		= ECullMode::Back;

			spec.SetRenderState( rs );
		}
	}

#endif
//-----------------------------------------------------------------------------
#ifdef SH_VERT
	#include "CodeTemplates.glsl"

	void Main ()
	{
		gl.Position = FullscreenTrianglePos();
	}

#endif
//-----------------------------------------------------------------------------
#ifdef SH_FRAG
	#include "ModelMaterial.glsl"
	#include "TexSampling.glsl"

	float  RescaleLod (float srcLod, float srcMips)		{ return srcLod * srcMips; }
	uint2  UnpackUShort (uint v)						{ return uint2( v & 0xFFFF, v >> 16 ); }


	void Main ()
	{
		const int2		coord		= int2(gl.FragCoord.xy);
		float3			normal		= ToSNorm( gl.texture.Fetch( un_GBufNormal, coord, 0 ).rgb );	// RGB10_A2_UNorm
		float2			uv			= gl.texture.Fetch( un_GBufUV, coord, 0 ).rg;					// RG16F
		float4			ref_duv		= gl.texture.Fetch( un_GBufRefUV, coord, 0 );
		uint4			packed		= gl.texture.Fetch( un_GBufPacked, coord, 0 );

		if ( packed.x == ~0u )
		{
			out_Color = float4(0.0f, 1.f, 1.f, 1.f);
			return;
		}

		const uint		mtr_id		= packed.x & 0xFF;
		const float3	world_pos	= UnpackWorldPos( un_Depth );
		ModelMaterial	mtr			= un_Materials.elements[ mtr_id ];
		const float		ref_lod		= SwQueryLod( float2(gl.texture.GetSize( un_AlbedoMaps[ UnpackMapAndSampler( mtr.albedoMap ).x ], 0 )), ref_duv ).y;
		float			tex_lod		= 100.0;

		// Texture LOD
		{
			const float		dst_mips = float(gl.texture.QueryLevels(  un_AlbedoMaps[ UnpackMapAndSampler( mtr.albedoMap ).x ] ));

			switch ( iLodPack )
			{
				case 0 :	// 8bit
					tex_lod = (float(packed.y) / 0xFF) * dst_mips;  break;

				case 1 :	// 12bit
					tex_lod = (float(packed.y) / 0xFFF) * dst_mips;  break;

				case 2 :	// 16bit
					tex_lod = unpackHalf2x16( packed.y ).x;  break;

				case 3 :	// 32bit
					tex_lod = uintBitsToFloat( packed.y );  break;
			}
		}

		// UV dxdy
		float4	packed_duv;
		{
			const float		max_duv	= 1.0;

			uint2	i_uv_dx	= UnpackUShort( packed.z );
			uint2	i_uv_dy	= UnpackUShort( packed.w );

			switch ( iDUVPack )
			{
				case 0 :	// 8bit x4
					packed_duv.xy = float2(i_uv_dx) / 0xFF;
					packed_duv.zw = float2(i_uv_dy) / 0xFF;
					packed_duv *= max_duv;
					break;

				case 1 :	// 12bit x4
					packed_duv.xy = float2(i_uv_dx) / 0xFFF;
					packed_duv.zw = float2(i_uv_dy) / 0xFFF;
					packed_duv *= max_duv;
					break;

				case 2 :	// 16bit x4
					packed_duv.xy = unpackHalf2x16( packed.z );
					packed_duv.zw = unpackHalf2x16( packed.w );
					break;
			}
		}

		float4	ref_albedo	= SampleGradAlbedo( mtr, uv, ref_duv.xy, ref_duv.zw );
		float4	albedo1		= SampleGradAlbedo( mtr, uv, packed_duv.xy, packed_duv.zw );
		float4	albedo2		= SampleLodAlbedo( mtr, uv, tex_lod );
		float4	light		= CalcLighting( world_pos, normal );
		float	scale		= Exp2( float(iCmpScale) );

		switch ( iCmp )
		{
			case 0 :	out_Color = ref_albedo * light;  break;
			case 1 :	out_Color = albedo1 * light;  break;
			case 2 :	out_Color = albedo2 * light;  break;
			case 3 :	out_Color = Abs( ref_albedo - albedo1 ) * scale;  break;
			case 4 :	out_Color = Abs( ref_duv - packed_duv ) * scale;  break;
			case 5 :	out_Color.rgb = Abs( ref_albedo - albedo2 ).rgb * scale;     out_Color.a = tex_lod;  break;
			case 6 :	out_Color.rgb = float3( Abs( ref_lod - tex_lod ) * scale );  out_Color.a = tex_lod;  break;
		}
	}

#endif
//-----------------------------------------------------------------------------
