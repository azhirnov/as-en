#ifdef __INTELLISENSE__
#	include <pipeline_compiler.as>
#	include <glsl.h>
#	define GRID
#	define SPHERES
#endif
//-----------------------------------------------------------------------------
#ifdef SCRIPT

	void  CreateGridPipeline ()
	{
		{
			RC<ShaderStructType>	st = ShaderStructType( "grid.io" );
			st.Set( EStructLayout::InternalIO,
					"float2		uv;" );
		}{
			RC<DescriptorSetLayout>	ds = DescriptorSetLayout( "grid.mtr.ds" );
			ds.UniformBuffer( EShaderStages::Vertex,	"un_PerObject", "UnifiedGeometryMaterialUB" );
			ds.StorageBuffer( EShaderStages::Vertex,	"un_Geometry",	"GeometrySBlock", EResourceState::ShaderStorage_Read );	// external
		}{
			RC<PipelineLayout>		pl = PipelineLayout( "grid.pl" );
			pl.DSLayout( "pass",	 0, "pass.ds" );
			pl.DSLayout( "material", 1, "grid.mtr.ds" );
		}

		RC<GraphicsPipeline>	ppln = GraphicsPipeline( "grid.tmpl" );
		ppln.SetLayout( "grid.pl" );
		ppln.SetFragmentOutputFromRenderTech( "rtech", "main" );
		ppln.SetShaderIO( EShader::Vertex, EShader::Fragment, "grid.io" );

		{
			RC<Shader>	vs = Shader();
			vs.LoadSelf();
			vs.Define( "GRID" );
			ppln.SetVertexShader( vs );
		}{
			RC<Shader>	fs = Shader();
			fs.LoadSelf();
			fs.Define( "GRID" );
			ppln.SetFragmentShader( fs );
		}

		// specialization
		{
			RC<GraphicsPipelineSpec>	spec = ppln.AddSpecialization( "Grid" );
			spec.AddToRenderTech( "rtech", "main" );  // in ScriptSceneGraphicsPass

			RenderState	rs;

			rs.inputAssembly.topology		= EPrimitive::TriangleList;

			rs.rasterization.frontFaceCCW	= true;
			rs.rasterization.cullMode		= ECullMode::None;

			spec.SetRenderState( rs );
		}
	}


	void  CreateSpheresPipeline ()
	{
		{
			RC<ShaderStructType>	st = ShaderStructType( "spheres.io" );
			st.Set( EStructLayout::InternalIO,
					"float4		color;" );
		}{
			RC<DescriptorSetLayout>	ds = DescriptorSetLayout( "spheres.mtr.ds" );
			ds.UniformBuffer( EShaderStages::Vertex,	"un_PerObject", "UnifiedGeometryMaterialUB" );
			ds.StorageBuffer( EShaderStages::Vertex,	"un_Geometry",	"GeometrySBlock", EResourceState::ShaderStorage_Read );	// external
		}{
			RC<PipelineLayout>		pl = PipelineLayout( "spheres.pl" );
			pl.DSLayout( "pass",	 0, "pass.ds" );
			pl.DSLayout( "material", 1, "spheres.mtr.ds" );
		}

		RC<GraphicsPipeline>	ppln = GraphicsPipeline( "spheres.tmpl" );
		ppln.SetLayout( "spheres.pl" );
		ppln.SetFragmentOutputFromRenderTech( "rtech", "main" );
		ppln.SetShaderIO( EShader::Vertex, EShader::Fragment, "spheres.io" );

		{
			RC<Shader>	vs = Shader();
			vs.LoadSelf();
			vs.Define( "SPHERES" );
			ppln.SetVertexShader( vs );
		}{
			RC<Shader>	fs = Shader();
			fs.LoadSelf();
			fs.Define( "SPHERES" );
			ppln.SetFragmentShader( fs );
		}

		// specialization
		{
			RC<GraphicsPipelineSpec>	spec = ppln.AddSpecialization( "Spheres" );
			spec.AddToRenderTech( "rtech", "main" );  // in ScriptSceneGraphicsPass

			RenderState	rs;

			rs.inputAssembly.topology		= EPrimitive::TriangleList;

			rs.rasterization.frontFaceCCW	= true;
			rs.rasterization.cullMode		= ECullMode::None;

			spec.SetRenderState( rs );
		}
	}


	void ASmain ()
	{
		CreateGridPipeline();
		CreateSpheresPipeline();
	}

#endif
//-----------------------------------------------------------------------------
#ifdef GRID
# ifdef SH_VERT
	#include "Matrix.glsl"
	#include "CubeMap.glsl"

	void Main ()
	{
		const uint		idx		= gl.VertexIndex;
		float2			coord	= un_Geometry.position[idx].xy;
		const int		face	= int(un_Geometry.position[idx].z);
		float4			pos		= float4( CM_TangentialSC_Forward( coord, face ), 1.f );

		pos = un_CBuf.cubemapProj * pos;

		gl.Position	= pos;
		gl.Layer	= gl.InstanceIndex;
		Out.uv		= coord * 4.0;	// lod
	}

# endif
//-----------------------------------------------------------------------------
# ifdef SH_FRAG
	#include "SDF.glsl"
	#include "CodeTemplates.glsl"

	#ifndef iGrid
	#	define iGrid	0
	#endif

	void Main ()
	{
		switch ( iGrid )
		{
			case 0 :	out_Color = float4(FSBarycentricWireframeCompat( In.uv, 0.0, 1.5 ).x);	break;
			case 1 :	out_Color = float4(AA_QuadGrid_dxdy( In.uv, float2(0.0, 1.5) ).x );		break;
		}
	}

# endif
#endif // GRID
//=============================================================================
#ifdef SPHERES
# ifdef SH_VERT
	#include "Hash.glsl"
	#include "Color.glsl"
	#include "CubeMap.glsl"

	void Main ()
	{
		const uint	idx		= gl.VertexIndex;
		const uint	uid		= gl.InstanceIndex / 6;
		const uint	layer	= gl.InstanceIndex % 6;

		float2	coord = ToSNorm( float2( uid & 15, (uid >> 4) & 15 ) / 15.0 );
		float3	gpos  = CM_TangentialSC_Forward( coord, int(uid >> 8) );

		float4	pos	= float4( CM_TangentialSC_Forward( un_Geometry.position[idx].xy, int(un_Geometry.position[idx].z) ), 1.f );
				pos.xyz = pos.xyz * 0.2 + gpos * 10.0;
				pos = un_CBuf.cubemapViewProj[layer] * pos;

		gl.Position	= pos;
		gl.Layer	= int(layer);
		Out.color	= Rainbow( DHash13( gpos * 100.0 ));
	}

# endif
//-----------------------------------------------------------------------------
# ifdef SH_FRAG

	void Main ()
	{
		out_Color = In.color;
	}

# endif
#endif // SPHERES
//-----------------------------------------------------------------------------
