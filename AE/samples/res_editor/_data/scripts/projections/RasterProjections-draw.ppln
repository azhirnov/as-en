//-----------------------------------------------------------------------------
#ifdef SCRIPT

	void CreatePipelines (string prefix, bool withUV, bool withNorm, bool translucent)
	{
		const bool	with_tess = true;

		if ( with_tess )
		{
			{
				RC<ShaderStructType>	st = ShaderStructType( prefix+"io.vs-tcs" );
				st.Set(	EStructLayout::InternalIO,
						"float3		worldNormal;"
						"float3		worldPos;"
						"uint		materialIdx;"
						"float2		texcoord;" );
			}{
				RC<ShaderStructType>	st = ShaderStructType( prefix+"io.tcs-tes" );
				st.Set( EStructLayout::InternalIO,
						"float3		worldNormal;"
						"float3		worldPos;"
						"uint		materialIdx;"
						"float2		texcoord;" );
			}{
				RC<ShaderStructType>	st = ShaderStructType( prefix+"io.tes-fs" );
				st.Set( EStructLayout::InternalIO,
						"float3		worldNormal;"
					//	"float		clip;"
						"float3		worldPos;"
						"uint		materialIdx;"
						"float2		texcoord;" );
			}
		}
		else
		{
			RC<ShaderStructType>	st = ShaderStructType( prefix+"io.vs-fs" );
			st.Set( EStructLayout::InternalIO,
					"float3		worldNormal;"
					"float3		worldPos;"
					"uint		materialIdx;"
					"float2		texcoord;" );
		}

		{
			RC<GraphicsPipeline>	ppln = GraphicsPipeline( prefix+"t" );
			ppln.SetLayout( "model.pl" );	// [InitPipelineLayout()](https://github.com/azhirnov/as-en/blob/dev/AE/samples/res_editor/_data/pipeline_inc/ModelTypes.as)

			if ( withUV and withNorm )	ppln.SetVertexInput( "VB{Posf3, Normf3, UVf2}" );	else
			if ( withNorm )				ppln.SetVertexInput( "VB{Posf3, Normf3}" );			else
			if ( withUV )				ppln.SetVertexInput( "VB{Posf3, UVf2}" );			else
										ppln.SetVertexInput( "VB{Posf3}" );

			ppln.SetFragmentOutputFromRenderTech( "rtech", "main" );

			if ( with_tess ) {
				ppln.SetShaderIO( EShader::Vertex,			EShader::TessControl,	 prefix+"io.vs-tcs" );
				ppln.SetShaderIO( EShader::TessControl,		EShader::TessEvaluation, prefix+"io.tcs-tes" );
				ppln.SetShaderIO( EShader::TessEvaluation,	EShader::Fragment,		 prefix+"io.tes-fs" );
			}else{
				ppln.SetShaderIO( EShader::Vertex,			EShader::Fragment,		 prefix+"io.vs-fs" );
			}

			{
				RC<Shader>	vs = Shader();
				vs.LoadSelf();
				if ( withUV ) vs.Define( "VS_TEXCOORD" );
				if ( withNorm ) vs.Define( "VS_NORMALS" );
				ppln.SetVertexShader( vs );
			}
			if ( with_tess )
			{
				{
					RC<Shader>	tcs = Shader();
					tcs.LoadSelf();
					tcs.TessPatchSize( 3 );
					ppln.SetTessControlShader( tcs );
				}{
					RC<Shader>	tes = Shader();
					tes.LoadSelf();
					tes.TessPatchMode( ETessPatch::Triangles, ETessSpacing::Equal, /*ccw*/false );
					ppln.SetTessEvalShader( tes );
				}
			}
			{
				RC<Shader>	fs = Shader();
				fs.LoadSelf();
				fs.Define( withUV ? "FS_TEXTURING" : "FS_FLAT_SHADING" );
				if ( not withNorm ) fs.Define( "GEN_NORMALS" );
				if ( translucent ) fs.Define( "TRANSLUCENT" );
				ppln.SetFragmentShader( fs );
			}

			// base render state
			RenderState	rs;
			{
				if ( translucent )
				{
					RenderState_ColorBuffer		cb;
					cb.SrcBlendFactor( EBlendFactor::SrcAlpha,			EBlendFactor::One				);
					cb.DstBlendFactor( EBlendFactor::OneMinusSrcAlpha,	EBlendFactor::OneMinusSrcAlpha	);
					cb.BlendOp( EBlendOp::Add );
					rs.color.SetColorBuffer( 0, cb );
				}

				rs.depth.test					= true;
				rs.depth.write					= true;

				rs.inputAssembly.topology		= with_tess ? EPrimitive::Patch : EPrimitive::TriangleList;

				rs.rasterization.frontFaceCCW	= true;
			}

			// specialization
			{
				RC<GraphicsPipelineSpec>	spec = ppln.AddSpecialization( prefix+"twosided" );
				spec.AddToRenderTech( "rtech", "main" );  // in ScriptSceneGraphicsPass

				rs.rasterization.cullMode	= ECullMode::None;
				spec.SetRenderState( rs );
			}

			if ( not translucent )
			{
				RC<GraphicsPipelineSpec>	spec = ppln.AddSpecialization( prefix+"cullback" );
				spec.AddToRenderTech( "rtech", "main" );  // in ScriptSceneGraphicsPass

				rs.rasterization.cullMode	= ECullMode::Back;
				spec.SetRenderState( rs );
			}
		}
	}


	void ASmain ()
	{
		CreatePipelines( "opaque-uv-norm.",	true,	true,	false );
		CreatePipelines( "opaque-norm.",	false,	true,	false );
		CreatePipelines( "opaque.",			false,	false,	false );
	}

#endif
//-----------------------------------------------------------------------------
#ifdef SH_VERT
	#include "Transform.glsl"

	void Main ()
	{
		ModelNode	node		= un_Nodes.elements[ gl.InstanceIndex ];	// only 'firstInstance'
		float4		world_pos	= LocalPosToWorldSpace( node.transform * float4( in_Position, 1.0f ));
		float3		view_pos	= world_pos.xyz;	// top down

		Out.worldPos	= world_pos.xyz;
		Out.materialIdx	= node.materialIdx;	// uniform per draw call

	  #ifdef VS_NORMALS
		Out.worldNormal	= Normalize( float3x3(node.transform) * in_Normal );
	  #endif
	  #ifdef VS_TEXCOORD
		Out.texcoord	= in_Texcoord;
	  #endif
	}

#endif
//-----------------------------------------------------------------------------
#ifdef SH_TESS_CTRL
	#include "Math.glsl"

	#define I	gl.InvocationID

	float  EdgeTessLevel (float3 p0, float3 p1)
	{
		float	edge_length		= Distance( p0, p1 );
		float	edge_center		= Distance( (p0 + p1) * 0.5f, float3(0.0f) );
		float	tess_level		= Max( 1.0, iTessLevel * edge_length / Max( edge_center, 0.001 ));
		return	tess_level;
	}

	void Main ()
	{
		if ( I == 0 )
		{
			float3 p0 = In[0].worldPos;
			float3 p1 = In[1].worldPos;
			float3 p2 = In[2].worldPos;

			gl.TessLevelOuter[0] = EdgeTessLevel( p1, p2 );
			gl.TessLevelOuter[1] = EdgeTessLevel( p2, p0 );
			gl.TessLevelOuter[2] = EdgeTessLevel( p0, p1 );

			gl.TessLevelInner[0] = (gl.TessLevelOuter[0] + gl.TessLevelOuter[1] + gl.TessLevelOuter[2]) / 3.0;
		}

		Out[I].worldPos		= In[I].worldPos;
		Out[I].materialIdx	= In[I].materialIdx;
		Out[I].worldNormal	= In[I].worldNormal;
		Out[I].texcoord		= In[I].texcoord;
	}

#endif
//-----------------------------------------------------------------------------
#ifdef SH_TESS_EVAL
	#include "Math.glsl"

	#define Interpolate( _arr_, _field_ )	InterpolateTriangle( _arr_, _field_, gl.TessCoord )

	void Main ()
	{
		float3	view_pos	= Interpolate( In, .worldPos );
		Out.worldNormal		= Interpolate( In, .worldNormal );
		Out.texcoord		= Interpolate( In, .texcoord );
		Out.materialIdx		= In[0].materialIdx;

		const float	z_near	= un_PerPass.camera.clipPlanes.x;
		const float	z_far	= un_PerPass.camera.clipPlanes.y;

		switch ( iProjection )
		{
			case 0 :	// paraboloid
			{
				view_pos.y = -view_pos.y;

				// see 'RayInverse_Paraboloid'
				float	d		= Max( Length( view_pos.xyz ), 1.0e-5 );
				float	d2		= Max( Length( view_pos.xz ), 1.0e-5 );
				float	r2		= ToUNorm( view_pos.y / d );

				gl.Position.xy	= view_pos.xz / d2 * r2;
				gl.Position.z	= Saturate( (d - z_near) / (z_far - z_near) );
				gl.Position.w	= 1.0;

				gl.ClipDistance[0] = 1.0;  // unused for paraboloid
				break;
			}

			case 1 :	// dual paraboloid
			case 2 :	// dual paraboloid v2
			{
				// see 'RayInverse_DualParaboloid'
				if ( iPassIdx == 1 )
					view_pos = float3( -view_pos.x, view_pos.y, -view_pos.z );	// back face

				float	len		= Length( view_pos.xyz );
				float3	dir		= view_pos.xyz / len;

				gl.Position.xy	= dir.xy / (dir.z + 1.0);
				gl.Position.z	= (len - z_near) / (z_far - z_near);
				gl.Position.w	= 1.0;

				if ( iProjection == 1 )
				{
					gl.ClipDistance[0]	= dir.z + iOverlap * 0.1;	// requires 'shaderClipDistance'
					//Out.clip			= dir.z + iOverlap * 0.1;
				}else{
					if ( dir.z < -iOverlap * 0.1 )
						gl.Position.z = -0.01;	// free clipping, but with UV distortion and missed triangles near to Z=0

					gl.ClipDistance[0] = 1.0;  // unused for this implementation
				}
				break;
			}
		}
	}

#endif
//-----------------------------------------------------------------------------
#ifdef FS_TEXTURING
	#include "ModelMaterial.glsl"
	#include "Normal.glsl"

	void Main ()
	{
		//if ( iProjection == 1 and In.clip < 0.0 )
		//	gl.Discard;

		// world-space normal
	  #ifdef GEN_NORMALS
		const float3	normal	= ComputeNormalInWS_dxdy( In.worldPos );
	  #else
		const float3	normal	= Normalize( In.worldNormal ) * (gl.FrontFacing ? 1.0 : -1.0);
	  #endif

		ModelMaterial	mtr		= un_Materials.elements[ In.materialIdx ];	// uniform per draw call
		float4			albedo	= SampleAlbedo( mtr, In.texcoord );

		if ( HasBit( mtr.flags, MtrFlag_AlphaTest ))	// uniform control flow
		{
			if ( albedo.a < 0.25 )
			{
			  #ifdef AE_demote_to_helper_invocation
				gl.Demote;
			  #else
				gl.Discard;
			  #endif
			}
		}

		out_Color = albedo;
	}

#endif
//-----------------------------------------------------------------------------
#ifdef FS_FLAT_SHADING
	#include "ModelMaterial.glsl"
	#include "Normal.glsl"

	void Main ()
	{
		//if ( iProjection == 1 and In.clip < 0.0 )
		//	gl.Discard;

	  #ifdef GEN_NORMALS
		const float3	normal	= ComputeNormalInWS_dxdy( In.worldPos );
	  #else
		const float3	normal	= Normalize( In.worldNormal );
	  #endif

		ModelMaterial	mtr		= un_Materials.elements[ In.materialIdx ];	// uniform per draw call
		float4			albedo	= UnpackRGBM( mtr.albedoRGBM );

		out_Color = albedo;
	}

#endif
