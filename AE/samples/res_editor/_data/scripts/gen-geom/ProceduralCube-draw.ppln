#ifdef __INTELLISENSE__
#	include <pipeline_compiler.as>
#	include <glsl.h>
#endif
//-----------------------------------------------------------------------------
#ifdef SCRIPT

	void ASmain ()
	{
		{
			RC<ShaderStructType>	st = ShaderStructType( "io" );
			st.Set( EStructLayout::InternalIO,
					"float3		worldPos;"
					"uint		face;" );
		}{
			RC<DescriptorSetLayout>	ds = DescriptorSetLayout( "mtr.ds" );
			ds.UniformBuffer( EShaderStages::Vertex, "un_PerObject", "UnifiedGeometryMaterialUB" );
		}{
			RC<PipelineLayout>		pl = PipelineLayout( "pl" );
			pl.DSLayout( "pass",	 0, "pass.ds" );
			pl.DSLayout( "material", 1, "mtr.ds" );
		}

		RC<GraphicsPipeline>	ppln = GraphicsPipeline( "tmpl" );
		ppln.SetLayout( "pl" );
		ppln.SetFragmentOutputFromRenderTech( "rtech", "main" );
		ppln.SetShaderIO( EShader::Vertex, EShader::Fragment, "io" );

		{
			RC<Shader>	vs = Shader();
			vs.LoadSelf();
			ppln.SetVertexShader( vs );
		}{
			RC<Shader>	fs = Shader();
			fs.LoadSelf();
			ppln.SetFragmentShader( fs );
		}

		// specialization
		{
			RC<GraphicsPipelineSpec>	spec = ppln.AddSpecialization( "spec" );
			spec.AddToRenderTech( "rtech", "main" );  // in ScriptSceneGraphicsPass

			RenderState	rs;

			rs.depth.test					= true;
			rs.depth.write					= true;

			rs.inputAssembly.topology		= EPrimitive::TriangleList;

			rs.rasterization.frontFaceCCW	= true;
			rs.rasterization.cullMode		= ECullMode::None;

			spec.SetRenderState( rs );
		}
	}

#endif
//-----------------------------------------------------------------------------
#ifdef SH_VERT
	#include "Transform.glsl"


	float3	Variant1 ()
	{
		const float3	vert_pos[8] = {
			float3( -1.0, -1.0, -1.0 ),
			float3(  1.0, -1.0, -1.0 ),
			float3(  1.0,  1.0, -1.0 ),
			float3( -1.0,  1.0, -1.0 ),
			float3( -1.0, -1.0,  1.0 ),
			float3(  1.0, -1.0,  1.0 ),
			float3(  1.0,  1.0,  1.0 ),
			float3( -1.0,  1.0,  1.0 )
		};

		const int	indices[36] = {
			// Back face (-z)
			 0, 1, 2,
			 2, 3, 0,

			// Front face (+z)
			 4, 5, 6,
			 6, 7, 4,

			// Left face (-x)
			 0, 3, 7,
			 7, 4, 0,

			// Right face (+x)
			 1, 5, 6,
			 6, 2, 1,

			// Bottom face (-y)
			 0, 1, 5,
			 5, 4, 0,

			// Top face (+y)
			 3, 2, 6,
			 6, 7, 3
		};

		uint	idx = indices[ gl.VertexIndex ];
		return vert_pos[ idx ];
	}


	uint  Mod3 (uint i)		{ return i >= 3 ? i - 3 : i; }


	float3	Variant3 ()
	{
		const uint	face	= gl.VertexIndex / 6;	// [0..5]
		const uint	nf		= face / 2;				// 0-X, 1-Y, 2-Z

		uint		vid		= gl.VertexIndex - face*6;
					vid		= vid <= 2 ? vid : (6 - vid);	// [0..2] | [1..3]

		float3		neg		= Saturate( float3( face == 0, face == 2, face == 4 ));
		float3		pos		= Saturate( float3( face == 1, face == 3, face == 5 ));
		float3		fpos	= pos - neg;	// [-1..+1]

		float3		vpos	= float3( vid & 1, (vid >> 1) & 1, 0.5 );
					vpos	= ToSNorm( float3( vpos[ Mod3(nf+2) ], vpos[ Mod3(nf+1) ], vpos[ Mod3(nf+0) ] ));	// [-1..+1]

		return (fpos + vpos).xzy;
	}


	void Main ()
	{
		float3	pos;
		switch ( iVariant )
		{
			case 0 :	pos = Variant1();	break;
			case 1 :	pos = Variant3();	break;
		}
		pos = LocalPosToWorldSpace( pos ).xyz;

		gl.Position		= WorldPosToClipSpace( pos );
		Out.worldPos	= pos.xyz;
		Out.face		= gl.VertexIndex / 6;
	}

#endif
//-----------------------------------------------------------------------------
#ifdef SH_FRAG
	#include "Normal.glsl"
	#include "Color.glsl"

	void  Main ()
	{
		const float3	light_dir	= Normalize(float3( 0.f, -1.f, 0.2f ));
		float3			norm		= ComputeNormalInWS_dxdy( In.worldPos );
		float			n_dot_l		= Max( Dot( light_dir, norm ), 0.1f );

		if ( iLighting == 0 )
			n_dot_l = 1.0;

		out_Color = Rainbow( float(In.face) / 5.0 ) * n_dot_l;
	}

#endif
